#!/usr/bin/env bash
# launch — bring the carrel container up (non-interactive)
set -e
cd "$(dirname "$0")/.."

# Ensure ~/.gitconfig exists as a file (Docker creates missing bind-mount
# sources as root-owned directories)
if [[ -d "$HOME/.gitconfig" ]]; then
    echo "Error: ~/.gitconfig is a directory. Fix: sudo rm -rf ~/.gitconfig" >&2
    exit 1
elif [[ ! -f "$HOME/.gitconfig" ]]; then
    echo "Warning: ~/.gitconfig missing, creating minimal one." >&2
    git config --global user.name "$(id -un)"
fi

# Generate .env if it doesn't exist
if [[ ! -f .env ]]; then
    WORKSPACE="$(cd "$(dirname "$0")/.." && dirname "$(pwd)")"
    MY_UID="$(id -u)"
    MY_GID="$(id -g)"

    echo "No .env file found. Inferred values:"
    echo "  WORKSPACE=$WORKSPACE"
    echo "  UID=$MY_UID"
    echo "  GID=$MY_GID"
    echo "  COMPOSE_PROJECT_NAME=carrel"
    echo ""
    read -p "Create .env with these values? [Y/n] " -r REPLY
    echo ""
    if [[ "$REPLY" =~ ^[Yy]?$ ]]; then
        cat > .env <<ENVEOF
WORKSPACE=$WORKSPACE
UID=$MY_UID
GID=$MY_GID
COMPOSE_PROJECT_NAME=carrel
ENVEOF
        echo ".env created. Edit and re-run bin/launch if values are wrong."
        exit 0
    else
        echo "Not created. Copy .env.example to .env and edit, then re-run bin/launch."
        exit 1
    fi
fi

if docker compose version &>/dev/null; then
	docker compose up -d --build
elif command -v docker-compose &>/dev/null; then
	docker-compose up -d --build
else
	echo "Error: neither docker compose nor docker-compose found" >&2
	exit 1
fi
