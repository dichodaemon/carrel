#!/usr/bin/env bash
# proxy -- non-interactive entry point for wezterm's proxy_command.
#
# Ensures the carula container is running (start only, never build),
# then execs wezterm cli proxy. All status output goes to stderr to
# keep stdout clean for the mux protocol.
#
# If the image doesn't exist, exits with an error message directing
# the user to bin/enter for an interactive build.
set -euo pipefail

CARREL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONTAINER=carrel

is_running() {
    docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true
}

if ! is_running; then
    echo "Carrel is not running. Starting..." >&2
    if ! docker compose -f "$CARREL_DIR/docker-compose.yml" up -d 2>&2; then
        echo "Failed to start carrel. Run 'bin/enter' on the host to build the image." >&2
        exit 1
    fi
    for i in $(seq 1 10); do
        is_running && break
        sleep 0.5
    done
    if ! is_running; then
        echo "Container failed to start. Run 'bin/enter' on the host to debug." >&2
        exit 1
    fi
    echo "Carrel started." >&2
fi

exec docker exec -i "$CONTAINER" wezterm cli proxy
