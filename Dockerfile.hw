# twang hardware (Zephyr) toolchain, layered on the general carrel image.
#
# Adds what the general image deliberately omits: the Zephyr build CLI (west +
# its pip deps) and the SEGGER J-Link software (for the EK-RA8D2's onboard
# debugger, Zephyr's `jlink` runner). The Zephyr SDK + source are NOT baked in
# here -- they live in the workspace mount (/workspace/zephyr-sdk,
# /workspace/zephyrproject).
#
# Build AFTER the base image exists (docker compose build carrel).
FROM carrel-carrel:latest

# Zephyr build deps (the build-imported subset of
# zephyr/scripts/requirements-base.txt): jsonschema/pykwalify/PyYAML
# (devicetree + module YAML validation), pyelftools (ELF), packaging
# (version checks), intelhex (hex merge), anytree (ram/rom report), semver.
# pylink-square is the `jlink` flash runner's Python binding to the J-Link SDK
# (it finds /opt/SEGGER/JLink/libjlinkarm.so installed by the .deb below).
RUN pip3 install --break-system-packages \
        west \
        jsonschema \
        pykwalify \
        PyYAML \
        pyelftools \
        packaging \
        intelhex \
        anytree \
        semver \
        pylink-square

# SEGGER J-Link software (JLinkExe/JLinkGDBServer) for the `jlink` runner.
# Vendored .deb, gitignored: download once from segger.com and drop it in
# .vendor/. COPY avoids a build-time network/login dependency and makes the
# version implicit (the file you have IS the version). Installed via apt-get
# (not dpkg -i) so the X11/XCB dependencies are resolved automatically.

# The .deb's postinst runs `udevadm control --reload-rules` and exits non-zero
# if it fails. There is no udev daemon in a container, and the rule only matters
# on the host (bin/udev-jlink.sh), so provide a no-op udevadm. It must live in
# /usr/bin (dpkg's maintainer-script PATH), not /usr/local/bin.
RUN printf '%s\n' '#!/bin/sh' 'exit 0' > /usr/bin/udevadm \
    && chmod +x /usr/bin/udevadm

COPY .vendor/JLink_Linux_*.deb /tmp/jlink.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/jlink.deb \
    && rm -f /tmp/jlink.deb \
    && rm -rf /var/lib/apt/lists/*

# USB device verification tooling for the twang spike (and future device work):
# usbutils = lsusb -v (descriptor/endpoint inspection), alsa-utils = amidi/
# aconnect (MIDI 2.0 UMP alt-setting checks) + aplay/arecord (UAC2 audio).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        usbutils \
        alsa-utils \
    && rm -rf /var/lib/apt/lists/*
